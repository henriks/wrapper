#!/usr/bin/env python3
"""Query the host wrapper from inside its guest VM."""
import argparse
import json
import sys

from host_rpc import get_status


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['status'])
    parser.parse_args()
    try:
        print(json.dumps(get_status(), indent=2))
    except (OSError, ValueError, RecursionError) as error:
        print(f'hostctl: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
