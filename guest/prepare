#!/bin/bash
set -euo pipefail
uid=$1 gid=$2 proxy=$3
mkdir -p /home/agent
if ! getent group "$gid" >/dev/null; then groupadd --gid "$gid" agent; fi
if ! getent passwd "$uid" >/dev/null; then
    useradd --uid "$uid" --gid "$gid" --home-dir /home/agent --shell /bin/bash agent
fi
chown "$uid:$gid" /home/agent
chmod 755 /run/sandbox-wrap
chown "$uid:$gid" /run/sandbox-wrap/host.sock
chmod 600 /run/sandbox-wrap/host.sock
if [[ $proxy == 1 ]]; then
    for attempt in {1..50}; do
        if (: > /dev/tcp/127.0.0.1/4750) 2>/dev/null; then break; fi
        if [[ ! -f /usr/local/lib/sandbox-wrap/network_proxy.py || $attempt == 50 ]]; then
            echo 'guest proxy is not listening on 127.0.0.1:4750; inspect smolvm machine logs. For an older image, run codex-wrap --rebuild-image, then codex-wrap --reset (deletes guest state).' >&2
            exit 1
        fi
        sleep 0.1
    done
fi
for attempt in {1..60}; do
    if docker info >/dev/null 2>&1; then exit 0; fi
    sleep 1
done
echo 'guest Docker failed to become ready; inspect smolvm machine logs' >&2
exit 1
