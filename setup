#!/usr/bin/env python3
"""Install the codex-wrap link and, when needed, the host AppArmor helper."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
RESTRICTION = Path('/proc/sys/kernel/apparmor_restrict_unprivileged_userns')
APPARMOR = Path('/sys/module/apparmor/parameters/enabled')
HELPER = Path('/usr/local/libexec/sandbox-wrap-unshare')
PROFILE = Path('/etc/apparmor.d/sandbox-wrap-unshare')


def needs_apparmor():
    try:
        return APPARMOR.read_text().strip() == 'Y' and RESTRICTION.read_text().strip() == '1'
    except FileNotFoundError:
        return False


def setup(bin_dir):
    commands = []
    if needs_apparmor():
        unshare = shutil.which('unshare')
        parser = shutil.which('apparmor_parser', path=os.environ.get('PATH', os.defpath) + ':/usr/sbin:/sbin')
        if not unshare or not parser:
            raise RuntimeError('AppArmor restricts user namespaces; install util-linux and the AppArmor tools, then rerun ./setup')
        sudo = []
        if os.geteuid() != 0:
            executable = shutil.which('sudo')
            if not executable:
                raise RuntimeError('installing the AppArmor helper requires root; rerun setup as root with --bin-dir pointing to your bin directory')
            sudo = [executable]
        commands = [
            [*sudo, 'install', '-D', '-m', '0755', unshare, str(HELPER)],
            [*sudo, 'install', '-D', '-m', '0644', str(ROOT / 'host/sandbox-wrap-unshare.apparmor'), str(PROFILE)],
            [*sudo, parser, '-r', str(PROFILE)],
        ]

    link = bin_dir / 'codex-wrap'
    if link.exists() and not link.is_symlink():
        raise RuntimeError(f'refusing to replace existing file: {link}')
    for command in commands:
        subprocess.run(command, check=True)
    if commands:
        print(f'Installed AppArmor helper: {HELPER}')
    else:
        print('AppArmor namespace helper is not required by this host.')

    bin_dir.mkdir(parents=True, exist_ok=True)
    if link.is_symlink():
        link.unlink()
    link.symlink_to(ROOT / 'sandbox-wrap')
    print(f'{link} -> {ROOT / "sandbox-wrap"}')
    if str(bin_dir) not in os.environ.get('PATH', '').split(os.pathsep):
        print(f'Add {bin_dir} to PATH to use codex-wrap by name.')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    default = Path('/usr/local/bin') if os.geteuid() == 0 else Path.home() / '.local/bin'
    parser.add_argument('--bin-dir', type=Path, default=default,
                        help='directory for the codex-wrap symlink (default: ~/.local/bin, or /usr/local/bin as root)')
    args = parser.parse_args()
    if sys.platform != 'linux':
        parser.error('sandbox-wrap requires a Linux host')
    try:
        setup(args.bin_dir.expanduser().absolute())
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        parser.exit(1, f'setup: {error}\n')


if __name__ == '__main__':
    main()
