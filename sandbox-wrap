#!/usr/bin/env python3
"""Run Codex or a command in a persistent project-local smolvm machine."""
import argparse
import fcntl
from contextlib import contextmanager, nullcontext
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile

from host_rpc import GUEST_SOCKET, serve_status
from vm_session import project_session
import network_proxy
import host_mounts

DEFAULT_IMAGE = Path(__file__).resolve().parent / "sandbox-wrap.tar"


def die(message):
    raise SystemExit(f"error: {message}")


def ensure_default_image(image, rebuild=False):
    if image != str(DEFAULT_IMAGE):
        if rebuild:
            die("--rebuild-image builds the default image; omit --image")
        return
    if DEFAULT_IMAGE.exists() and not rebuild:
        return
    with DEFAULT_IMAGE.with_suffix(".build.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if DEFAULT_IMAGE.exists() and not rebuild:
            return
        if not shutil.which("docker"):
            die("building the default image requires host Docker; install Docker or supply --image")
        print("Building the default development image...", flush=True)
        root = Path(__file__).resolve().parent
        subprocess.run(["docker", "build", "-t", "sandbox-wrap:latest", str(root)],
                       check=True, timeout=300)
        with tempfile.TemporaryDirectory(dir=DEFAULT_IMAGE.parent, prefix=".sandbox-image-") as temporary:
            archive = Path(temporary) / "image.tar"
            subprocess.run(["docker", "save", "-o", str(archive), "sandbox-wrap:latest"],
                           check=True, timeout=120)
            archive.replace(DEFAULT_IMAGE)


def credential_environment(output):
    credentials = json.loads(output)
    if not isinstance(credentials, dict):
        raise ValueError("AWS credential output must be an object")
    env = {}
    for source, target in (("AccessKeyId", "AWS_ACCESS_KEY_ID"),
                           ("SecretAccessKey", "AWS_SECRET_ACCESS_KEY"),
                           ("SessionToken", "AWS_SESSION_TOKEN")):
        value = credentials.get(source)
        if value is not None:
            if not isinstance(value, str) or not value or "\x00" in value:
                raise ValueError(f"invalid AWS credential field: {source}")
            env[target] = value
    if not all(env.get(key) for key in ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY")):
        raise ValueError("AWS credential output is missing access key or secret key")
    return env


def acquire_aws_credentials(profile: str) -> dict[str, str]:
    """Acquire AWS credentials for the given profile.

    Uses 'aws configure export-credentials' which works universally
    across credential sources: IAM Identity Center (SSO), IAM users,
    assumed roles, etc.
    """
    # Export credentials as JSON
    try:
        result = subprocess.run(
            ["aws", "configure", "export-credentials",
             "--profile", profile, "--format", "process"],
            capture_output=True, text=True, timeout=30,
        )
    except FileNotFoundError:
        die("aws CLI is not installed")
    except subprocess.TimeoutExpired:
        die(f"Timed out acquiring AWS credentials for profile '{profile}'")

    if result.returncode != 0:
        die(f"Failed to export AWS credentials for profile '{profile}':\n"
            f"{result.stderr.strip()}\n"
            f"You may need to run: aws sso login --profile {profile}")

    try:
        env = credential_environment(result.stdout)
    except ValueError:
        die(f"Failed to parse AWS credentials output for profile '{profile}'")

    # Determine the region from the profile
    try:
        result = subprocess.run(
            ["aws", "configure", "get", "region", "--profile", profile],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode == 0 and result.stdout.strip():
            env["AWS_DEFAULT_REGION"] = result.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass

    return env


def acquire_gh_token() -> str | None:
    """Extract GitHub CLI auth token from the host keyring via 'gh auth token'."""
    try:
        result = subprocess.run(
            ["gh", "auth", "token"],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass
    return None



def parse_args(argv):
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("--project", type=Path, default=Path.cwd())
    p.add_argument("--image", default=str(DEFAULT_IMAGE), help="Registry image or docker-save archive; default builds automatically when missing")
    p.add_argument("--codex-home", type=Path, default=None, help="Host Codex directory to share (default ~/.codex)")
    p.add_argument('--help-config', action='store_true', help='Print the sandbox configuration reference and exit')
    p.add_argument("--entrypoint", metavar="PROGRAM", help="Run PROGRAM instead of Codex; arguments follow -- (e.g. --entrypoint bash)")
    network = p.add_mutually_exclusive_group()
    network.add_argument("--no-net", action="store_true")
    network.add_argument('--unfiltered-net', action='store_true', help='Allow any public CONNECT destination without domain filtering')
    network.add_argument('--raw-net', action='store_true', help='Enable direct VM networking without the proxy')
    p.add_argument('--allow-domain', action='append', default=None, help='Replace configured allow list (repeatable); enables proxy mode')
    p.add_argument('--deny-domain', action='append', default=None, help='Replace configured deny list (repeatable); enables proxy mode')
    p.add_argument("--git", action="store_true", help="Allow git metadata writes")
    p.add_argument("--aws", metavar="PROFILE")
    p.add_argument("--gh", action="store_true")
    p.add_argument("--ro", action="append", default=[])
    p.add_argument("--rw", action="append", default=[])
    p.add_argument("--port", action="append", default=[], help="HOST:GUEST port mapping")
    p.add_argument("--pass-env", action="append", default=[])
    actions = p.add_mutually_exclusive_group()
    actions.add_argument("--reset", action="store_true")
    actions.add_argument("--rebuild-image", action="store_true", help="Rebuild/export the default image and exit; existing VMs are unchanged")
    p.add_argument("command", nargs=argparse.REMAINDER, help="Guest command, or arguments to --entrypoint (after --)")
    a = p.parse_args(argv)
    if a.command[:1] == ["--"]:
        a.command = a.command[1:]
    if (a.no_net or a.raw_net or a.unfiltered_net) and (a.allow_domain is not None or a.deny_domain is not None):
        p.error('network mode switches cannot be combined with domain rules')
    if a.entrypoint is not None and (a.reset or a.rebuild_image):
        p.error("--entrypoint cannot be combined with --reset or --rebuild-image")
    return a


def volume(source, target, readonly=False):
    source = Path(source).resolve(strict=True)
    if not source.is_dir() or any(c in str(source) + str(target) for c in ":\n\r\x00"):
        die(f"volume must be a directory with no colon or newline: {source}")
    return f"{source}:{target}:{'ro' if readonly else 'rw'}"


def mount_plan(a, project):
    mounts = [volume(project, project)]
    codex = a.codex_home or Path.home() / ".codex"
    if codex.is_dir():
        mounts.append(volume(codex, "/home/agent/.codex"))
    for paths, readonly in ((a.ro, True), (a.rw, False)):
        for path in paths:
            target = Path(path).resolve(strict=True)
            # Extra volumes cannot override the workspace or its protected children.
            if target == project or target in project.parents or project in target.parents:
                die("extra mounts must not overlap the project")
            if target == Path("/home/agent") or Path("/home/agent") in target.parents or target in Path("/home/agent").parents:
                die("extra mounts must not overlap guest HOME")
            mounts.append(volume(target, target, readonly))
    if (project / ".git").exists():
        # Git worktrees have a .git file pointing at metadata outside the project.
        for option in ("--absolute-git-dir", "--git-common-dir"):
            result = subprocess.run(["git", "-C", str(project), "rev-parse", option],
                                    capture_output=True, text=True, check=True, timeout=10)
            path = Path(result.stdout.strip())
            if not path.is_absolute():
                path = project / path
            path = path.resolve()
            if not a.git or (path != project and project not in path.parents):
                mounts.append(volume(path, path, not a.git))
    return list(dict.fromkeys(mounts))


def main():
    a = parse_args(sys.argv[1:])
    if a.help_config:
        print(Path(__file__).resolve().with_name('config-json.md').read_text(), end='')
        return
    if a.rebuild_image:
        if a.command:
            die("--rebuild-image does not run a guest command")
        ensure_default_image(a.image, rebuild=True)
        return
    project = a.project.resolve(strict=True)
    if not project.is_dir() or project == Path("/") or project == Path("/home/agent") or project in Path("/home/agent").parents:
        die("project must be a directory outside the guest HOME ancestors")
    if not a.reset:
        host_mounts.ensure_namespace()
    def choose_network(base):
        return network_proxy.select_policy(base, raw_net=a.raw_net, unfiltered_net=a.unfiltered_net, no_net=a.no_net,
                                           allow=a.allow_domain, deny=a.deny_domain)
    proxy_enabled = None
    for port in a.port:
        if not re.fullmatch(r"[0-9]+:[0-9]+", port) or not all(0 < int(n) < 65536 for n in port.split(":")):
            die("ports must be HOST:GUEST with values 1..65535")
    for key in a.pass_env:
        if not re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]*", key):
            die("invalid environment variable name")
    if not shutil.which("smolvm"):
        die("smolvm is not installed")
    state = project / ".sandbox"
    env = os.environ.copy()
    env["SMOLVM_DATA_DIR"] = str(state)
    def smol(*args, capture=False, check=True, timeout=120, input=None):
        return subprocess.run(["smolvm", "machine", *args], env=env,
                              check=check, capture_output=capture, text=True, timeout=timeout, input=input)
    name = "sandbox"
    mounts = [] if a.reset else mount_plan(a, project)
    settings_path = state / "launch.json"
    socket_path = state / "host.sock"
    def attach():
        nonlocal proxy_enabled
        previous = json.loads(settings_path.read_text())
        if previous.get('host_mounts') != host_mounts.LAYOUT:
            die('active VM predates host mount protection; close its sessions before restarting')
        current = previous.get('proxy') or network_proxy.policy({'mode': 'direct' if previous['network'] else 'off'})
        network = choose_network(current)
        if network != current:
            die('network policy conflicts with active sessions')
        proxy_enabled = network['mode'] == 'proxy'
        # Unspecified machine options inherit the already-running VM settings.
        conflict = ((a.git and not previous["git"]) or (a.no_net and previous["network"])
                    or (a.port and a.port != previous["ports"]))
        for paths, readonly in ((a.ro, True), (a.rw, False)):
            for path in paths:
                target = Path(path).resolve(strict=True)
                conflict = conflict or volume(target, target, readonly) not in previous["mounts"]
        if a.codex_home is not None:
            def codex_mount(items):
                return next((m for m in items if m.split(':')[1] == '/home/agent/.codex'), None)
            conflict = conflict or codex_mount(mounts) != codex_mount(previous["mounts"])
        if conflict:
            die("machine settings conflict with active sessions; close them before changing settings")
    @contextmanager
    def boot():
        network = choose_network(network_proxy.configuration(project))
        proxy_enabled = network['mode'] == 'proxy'
        settings = {"mounts": mounts, "ports": a.port, "git": a.git, "network": network["mode"] == "direct",
                    "rpc_socket": str(socket_path), "proxy": network if proxy_enabled else None,
                    "host_mounts": host_mounts.LAYOUT}
        ensure_default_image(a.image)
        records = json.loads(smol("ls", "--json", capture=True).stdout)
        exists = bool(records)
        previous = json.loads(settings_path.read_text()) if settings_path.exists() else None
        if exists and previous is None:
            die("unrecognized .sandbox state; move it aside before launching")
        if exists and previous.get("rpc_socket") != str(socket_path):
            die("this VM predates host RPC; run --rebuild-image, then --reset to recreate it (reset deletes guest state)")
        if exists and proxy_enabled and not previous.get('proxy_socket'):
            die('this VM has no proxy bridge; rebuild the image and --reset to recreate it (reset deletes guest state)')
        if proxy_enabled or (previous and previous.get('proxy_socket')):
            settings['proxy_socket'] = str(state / 'proxy.sock')
        status = {"state": "starting", "machine": name, "project": str(project),
                  "wrapper_pid": os.getpid(), "network": settings["network"], "proxy": proxy_enabled,
                  "git_writable": a.git, "published_ports": a.port}
        relay = (network_proxy.serve_proxy(state / 'proxy.sock', network if proxy_enabled else {'mode': 'proxy', 'allow': []})
                 if settings.get('proxy_socket') else nullcontext())
        if exists:
            smol('stop', '--name', name)
        exported = host_mounts.prepare(project, mounts, a.git)
        with serve_status(socket_path, status), relay:
            if not exists:
                create = ["create", "--name", name, "--image", a.image,
                          "--volume", "/var/lib/docker",
                          "--mount-socket", f"{socket_path}:{GUEST_SOCKET}"]
                create += ['--env', f'SANDBOX_WRAP_PROXY={int(proxy_enabled)}']
                if proxy_enabled:
                    create += ['--mount-socket', f'{state / "proxy.sock"}:{network_proxy.GUEST_SOCKET}']
                if settings['network']:
                    create += ["--net", "--net-backend", "virtio-net"]
                for item in exported:
                    create += ["--volume", item]
                for port in a.port:
                    create += ["--port", port]
                smol(*create)
            elif previous != settings:
                update = ["update", "--name", name, "--net" if settings["network"] else "--no-net",
                          "--env", f"SANDBOX_WRAP_PROXY={int(proxy_enabled)}"]
                old = (host_mounts.volumes(state, previous['mounts'])
                       if previous.get('host_mounts') else previous['mounts'])
                for item in old:
                    update += ["--remove-volume", item.rsplit(":", 1)[0]]
                for port in previous["ports"]:
                    update += ["--remove-port", port]
                for item in exported:
                    update += ["--volume", item]
                for port in a.port:
                    update += ["--port", port]
                smol(*update)
            if not exists or previous != settings:
                settings_path.write_text(json.dumps(settings))
            try:
                smol("start", "--name", name, timeout=300)
                smol("exec", "--name", name, "--interactive", "--stream", "--", "bash", "-s", "--",
                     str(os.getuid()), str(os.getgid()),
                     input=(Path(__file__).resolve().parent / 'guest/prepare').read_text())
                status["state"] = "running"
                yield
            finally:
                status["state"] = "stopping"
                smol("stop", "--name", name, check=True)

    with project_session(project, boot, attach, reset=a.reset):
        if a.reset:
            if os.path.ismount(state / 'exports'):
                die('cannot reset from an active host export namespace')
            if json.loads(smol("ls", "--json", capture=True).stdout):
                smol("delete", "--name", name, "--force")
            for child in state.iterdir():
                if child.name != 'config.json':
                    if child.is_dir() and not child.is_symlink():
                        shutil.rmtree(child)
                    else:
                        child.unlink()
            return
        # Boot runs in the supervisor process; the first client also needs the
        # recorded policy, rather than policy values computed in that child.
        if proxy_enabled is None:
            attach()
        def terminate(signum, frame):
            raise SystemExit(128 + signum)
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, terminate)
        secrets = {key: os.environ[key] for key in a.pass_env if key in os.environ}
        if a.aws:
            secrets.update(acquire_aws_credentials(a.aws))
        if a.gh:
            token = acquire_gh_token()
            if not token:
                die("could not acquire GitHub token; run gh auth login on the host")
            secrets["GH_TOKEN"] = token
        execute = ["exec", "--name", name, "--workdir", str(project), "--interactive"]
        if sys.stdin.isatty() and sys.stdout.isatty():
            execute.append("--tty")
        else:
            execute.append("--stream")
        for key, value in secrets.items():
            host_key = f"SANDBOX_WRAP_SECRET_{key}"
            env[host_key] = value
            execute += ["--secret-env", f"{key}={host_key}"]
        for key, value in {"TERM": os.environ.get("TERM", "xterm-256color"),
                           "LANG": "C.UTF-8"}.items():
            execute += ["--env", f"{key}={value}"]
        if proxy_enabled:
            for key, value in network_proxy.environment().items():
                execute += ['--env', f'{key}={value}']
        command = [a.entrypoint, *a.command] if a.entrypoint is not None else (a.command or ["codex", "--dangerously-bypass-approvals-and-sandbox"])
        execute += ["--", "/usr/local/lib/sandbox-wrap/run", str(os.getuid()), str(os.getgid()), *command]
        # No timeout on the interactive agent session; lifecycle is the user's.
        result = subprocess.run(["smolvm", "machine", *execute], env=env)
        return result.returncode if result.returncode >= 0 else 128 - result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, OSError, ValueError, RuntimeError) as error:
        die(str(error))
