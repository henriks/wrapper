    virtiofsd_log: str
    proxy_log: str
    console_log: str


@dataclass
class DockerVmManager:
    """Manage the per-project QEMU Docker VM runtime."""

    project: str
    sandbox: str
    repo_root: str
    network_enabled: bool = False
    published_ports: list[DockerVmForward] = field(default_factory=list)
    paths: DockerVmPaths = field(init=False)
    manifest: dict | None = field(default=None, init=False)
    lock_fd: int | None = field(default=None, init=False)
    virtiofsd_proc: subprocess.Popen | None = field(default=None, init=False)
    qemu_proc: subprocess.Popen | None = field(default=None, init=False)
    proxy_proc: subprocess.Popen | None = field(default=None, init=False)
    host_tools: dict[str, str] = field(default_factory=dict, init=False)
    network: DockerVmNetwork | None = field(default=None, init=False)
    host_docker_port: int | None = field(default=None, init=False)

    def __post_init__(self) -> None:
        root = os.path.join(self.sandbox, DOCKER_VM_DIRNAME)
        run = os.path.join(root, DOCKER_VM_RUN_DIRNAME)
        self.paths = DockerVmPaths(
            root=root,
            run=run,
            lock=os.path.join(root, "lock"),
            data_disk=os.path.join(root, "docker-data.raw"),
            data_disk_meta=os.path.join(root, "docker-data.meta.json"),
            state=os.path.join(run, "state.json"),
            docker_sock=os.path.join(run, "docker.sock"),
            virtiofs_sock=os.path.join(run, "virtiofs.sock"),
            qemu_pid=os.path.join(run, "qemu.pid"),
            virtiofsd_pid=os.path.join(run, "virtiofsd.pid"),
            proxy_pid=os.path.join(run, "proxy.pid"),
            qemu_log=os.path.join(run, "qemu.log"),
            virtiofsd_log=os.path.join(run, "virtiofsd.log"),
            proxy_log=os.path.join(run, "proxy.log"),
            console_log=os.path.join(run, "console.log"),
        )
    def load_manifest(self) -> dict:
        if self.manifest is not None:
            return self.manifest
        manifest_path = os.path.join(
            self.repo_root, "docker", "out", "artifact-manifest.json")
        if not os.path.exists(manifest_path):
            raise DockerVmError(
                f"Docker VM artifact manifest is missing: {manifest_path}\n"
                "Run docker/build-appliance.sh first."
            )
        try:
            with open(manifest_path) as f:
                manifest = json.load(f)
        except (OSError, json.JSONDecodeError) as exc:
            raise DockerVmError(
                f"Failed to load Docker VM manifest {manifest_path}: {exc}"
            ) from exc

        artifacts = manifest.get("artifacts", {})
        for key in ("kernel", "initrd", "rootfs"):
            rel = artifacts.get(key)
            if not rel:
                raise DockerVmError(
                    f"Docker VM manifest is missing artifacts.{key}")
            path = os.path.join(self.repo_root, rel)
            artifacts[key] = os.path.abspath(path)
            if not os.path.exists(artifacts[key]):
                raise DockerVmError(
                    f"Docker VM artifact is missing: {artifacts[key]}")
        self.manifest = manifest
        return manifest

    def ensure_host_prerequisites(self) -> None:
        self.load_manifest()
        required_bins = ["qemu-system-x86_64", "virtiofsd", "mkfs.ext4"]
        self.host_tools = {}
        missing = []
        for name in required_bins:
            resolved = resolve_host_binary(name)
            if resolved:
                self.host_tools[name] = resolved
            else:
                missing.append(name)
        if missing:
            raise DockerVmError(
                "Missing required Docker VM host tools: "
                + ", ".join(missing)
            )
        if not os.path.exists("/dev/kvm"):
            raise DockerVmError("/dev/kvm is required for Docker VM support")
        if not is_rw_accessible("/dev/kvm"):
            raise DockerVmError(
                "/dev/kvm exists but is not readable/writable by the current "
                "user")

    def ensure_runtime_root(self) -> None:
        os.makedirs(self.paths.root, exist_ok=True)

    def acquire_lock(self) -> None:
        self.ensure_runtime_root()
        fd = os.open(self.paths.lock, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError as exc:
            os.close(fd)
            raise DockerVmError(
                "A Docker sandbox is already active for this project") from exc
        os.ftruncate(fd, 0)
        os.write(fd, f"{os.getpid()}\n".encode())
        os.fsync(fd)
        self.lock_fd = fd

    def release_lock(self) -> None:
        if self.lock_fd is None:
            return
        try:
            fcntl.flock(self.lock_fd, fcntl.LOCK_UN)
        finally:
            os.close(self.lock_fd)
            self.lock_fd = None

    def reset_is_allowed(self) -> bool:
        self.ensure_runtime_root()
        fd = os.open(self.paths.lock, os.O_RDWR | os.O_CREAT, 0o600)
        try:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return True
            except BlockingIOError:
                return False
        finally:
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            except OSError:
                pass
            os.close(fd)

    def remove_stale_run_dir(self) -> None:
        if os.path.isdir(self.paths.run):
            shutil.rmtree(self.paths.run)

    def create_run_dir(self) -> None:
        os.makedirs(self.paths.run, exist_ok=True)

    def write_state(self, status: str, **extra: object) -> None:
        state = {
            "status": status,
            "project": self.project,
            "sandbox": self.sandbox,
            "updated_at": int(time.time()),
        }
        state.update(extra)
        with open(self.paths.state, "w") as f:
            json.dump(state, f, indent=2, sort_keys=True)
            f.write("\n")

    def ensure_data_disk(self) -> None:
        if os.path.exists(self.paths.data_disk):
            return
        subprocess.run(
            ["truncate", "-s", str(DOCKER_VM_DATA_DISK_SIZE), self.paths.data_disk],
            check=True,
        )
        subprocess.run(
            [self.host_tools["mkfs.ext4"], "-F", self.paths.data_disk],
            check=True,
            capture_output=True,
            text=True,
        )
        meta = {
            "format_version": 1,
            "logical_size_bytes": DOCKER_VM_DATA_DISK_SIZE,
            "filesystem": DOCKER_VM_DATA_DISK_FS,
            "created_at": int(time.time()),
        }
        with open(self.paths.data_disk_meta, "w") as f:
            json.dump(meta, f, indent=2, sort_keys=True)
            f.write("\n")

    def _compute_network(self) -> DockerVmNetwork:
        digest = hashlib.sha256(self.project.encode()).hexdigest()
        guest_mac = "02:fc:%s:%s:%s:%s" % (
            digest[0:2], digest[2:4], digest[4:6], digest[6:8]
        )
        return DockerVmNetwork(
            guest_ip=DOCKER_VM_USERNET_GUEST_IP,
            prefix_len=DOCKER_VM_USERNET_PREFIX,
            gateway_ip=DOCKER_VM_USERNET_HOST_IP,
            guest_mac=guest_mac,
            dns_ip=DOCKER_VM_USERNET_DNS_IP,
        )

    def _allocate_host_docker_port(self) -> int:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind(("127.0.0.1", 0))
            return int(sock.getsockname()[1])

    def _open_log(self, path: str):
        return open(path, "a")

    def _write_pid(self, path: str, pid: int) -> None:
        with open(path, "w") as f:
            f.write(f"{pid}\n")

    def start_virtiofsd(self) -> None:
        log = self._open_log(self.paths.virtiofsd_log)
        cmd = [
            self.host_tools["virtiofsd"],
            f"--socket-path={self.paths.virtiofs_sock}",
            f"--shared-dir={self.project}",
            "--sandbox=none",
            "--inode-file-handles=never",
            "--cache=never",
            f"--thread-pool-size={DOCKER_VM_VIRTIOFS_NUM_QUEUES}",
            "--log-level=debug",
        ]
        self.virtiofsd_proc = subprocess.Popen(
            cmd,
            stdout=log,
            stderr=subprocess.STDOUT,
            close_fds=True,
        )
        self._write_pid(self.paths.virtiofsd_pid, self.virtiofsd_proc.pid)
        self.wait_for_path(self.paths.virtiofs_sock, timeout=10.0)

    def _build_hostfwd_specs(self, guest_docker_port: int) -> list[str]:
        if self.host_docker_port is None:
            raise DockerVmError("Host Docker forward port was not allocated")
        specs = [
            f"hostfwd=tcp:127.0.0.1:{self.host_docker_port}-:{guest_docker_port}"
        ]
        if self.network_enabled:
            for forward in self.published_ports:
                specs.append(
                    "hostfwd=tcp:127.0.0.1:"
                    f"{forward.host_port}-:{forward.guest_port}"
                )
        return specs

    def build_qemu_command(self) -> list[str]:
        manifest = self.load_manifest()
        artifacts = manifest["artifacts"]
        vm_cfg = manifest.get("vm")
        if not vm_cfg:
            raise DockerVmError(
                "Docker VM manifest is missing the vm stanza. "
                "Rebuild the appliance with docker/build-appliance.sh."
            )
        guest_cfg = manifest.get("guest", {})
        guest_docker_port = guest_cfg.get("docker_tcp_port")
        if guest_docker_port is None:
            raise DockerVmError(
                "Docker VM manifest is missing guest.docker_tcp_port. "
                "Rebuild the appliance with docker/build-appliance.sh."
            )
        guest_docker_port = int(guest_docker_port)
        assert self.network is not None

        kernel_cmdline = ensure_kernel_cmdline_rootfstype_ext4(
            vm_cfg["kernel_cmdline"]
        )
        kernel_cmdline = ensure_kernel_cmdline_console_ttys0(kernel_cmdline)
        kernel_cmdline = append_kernel_cmdline_arg(
            kernel_cmdline,
            "agentvm_project",
            self.project,
        )
        kernel_cmdline = append_kernel_cmdline_arg(
            kernel_cmdline,
            "agentvm_guest_ip",
            self.network.guest_ip,
        )
        kernel_cmdline = append_kernel_cmdline_arg(
            kernel_cmdline,
            "agentvm_gateway_ip",
            self.network.gateway_ip,
        )
        kernel_cmdline = append_kernel_cmdline_arg(
            kernel_cmdline,
            "agentvm_prefix_len",
            str(self.network.prefix_len),
        )
        kernel_cmdline = append_kernel_cmdline_arg(
            kernel_cmdline,
            "agentvm_dns",
            self.network.dns_ip,
        )
        kernel_cmdline = append_kernel_cmdline_arg(
            kernel_cmdline,
            "agentvm_guest_mac",
            self.network.guest_mac,
        )

        hostfwd_specs = self._build_hostfwd_specs(guest_docker_port)
        nic_parts = [
            "user",
            "id=net0",
            "model=virtio-net-pci",
            f"mac={self.network.guest_mac}",
            "ipv6=off",
            "hostname=agentvm",
            f"net=10.0.2.0/{DOCKER_VM_USERNET_PREFIX}",
            f"host={DOCKER_VM_USERNET_HOST_IP}",
            f"dns={DOCKER_VM_USERNET_DNS_IP}",
            f"restrict={'off' if self.network_enabled else 'on'}",
        ]
        nic_parts.extend(hostfwd_specs)

        memory_bytes = int(vm_cfg["memory_bytes"])
        memory_mib = max(1, memory_bytes // (1024 * 1024))
        return [
            self.host_tools["qemu-system-x86_64"],
            "-enable-kvm",
            "-nodefaults",
            "-no-user-config",
            "-no-reboot",
            "-display", "none",
            "-serial", f"file:{self.paths.console_log}",
            "-monitor", "none",
            "-machine", "q35,accel=kvm,memory-backend=mem",
            "-object",
            f"memory-backend-memfd,id=mem,size={memory_bytes},share=on",
            "-m", str(memory_mib),
            "-smp", str(vm_cfg["cpus"]),
            "-kernel", artifacts["kernel"],
            "-initrd", artifacts["initrd"],
            "-append", kernel_cmdline,
            "-drive",
            f"if=none,file={artifacts['rootfs']},format=raw,readonly=on,id=rootfs",
            "-device", "virtio-blk-pci,drive=rootfs",
            "-drive",
            f"if=none,file={self.paths.data_disk},format=raw,id=dockerdata",
            "-device", "virtio-blk-pci,drive=dockerdata",
            "-object", "rng-random,id=rng0,filename=/dev/urandom",
            "-device", "virtio-rng-pci,rng=rng0",
            "-chardev",
            f"socket,id=charfs,path={self.paths.virtiofs_sock}",
            "-device",
            "vhost-user-fs-pci,"
            f"chardev=charfs,tag={vm_cfg['virtiofs_tag']},"
            f"queue-size={DOCKER_VM_VIRTIOFS_QUEUE_SIZE},"
            f"num-request-queues={DOCKER_VM_VIRTIOFS_NUM_QUEUES}",
            "-nic", ",".join(nic_parts),
        ]

    def start_qemu(self) -> None:
        log = self._open_log(self.paths.qemu_log)
        self.qemu_proc = subprocess.Popen(
            self.build_qemu_command(),
            stdout=log,
            stderr=subprocess.STDOUT,
            close_fds=True,
        )
        self._write_pid(self.paths.qemu_pid, self.qemu_proc.pid)

    def wait_for_path(self, path: str, timeout: float) -> None:
        deadline = time.time() + timeout
        while time.time() < deadline:
            if os.path.exists(path):
                return
            self._ensure_processes_alive()
            time.sleep(0.1)
        raise DockerVmError(f"Timed out waiting for {path}")

    def _ensure_processes_alive(self) -> None:
        processes: list[tuple[str, subprocess.Popen | None, str]] = [
            ("virtiofsd", self.virtiofsd_proc, self.paths.virtiofsd_log),
            ("qemu", self.qemu_proc, self.paths.qemu_log),
            ("docker-vm-proxy", self.proxy_proc, self.paths.proxy_log),
        ]
        for name, proc, log_path in processes:
            if proc is not None and proc.poll() is not None:
                log_tail = read_tail(log_path)
                detail = f"{name} exited unexpectedly"
                if log_tail:
                    detail += f":\n{log_tail}"
                raise DockerVmError(detail)

    def unix_http_request(self, sock_path: str, request: bytes
                          ) -> tuple[int, bytes]:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(sock_path)
            sock.sendall(request)
            status_code, _headers, body_blob = read_http_response_from_socket(
                sock, sock_path)
        return status_code, body_blob

    def start_proxy(self) -> None:
        if self.host_docker_port is None:
            raise DockerVmError("Host Docker forward port was not allocated")
        log = self._open_log(self.paths.proxy_log)
        wrapper_script = os.path.join(self.repo_root, "sandbox-wrap")
        cmd = [
            sys.executable,
            "-u",
            wrapper_script,
            "__docker-vm-proxy",
            "--listen",
            self.paths.docker_sock,
            "--target-host",
            "127.0.0.1",
            "--target-port",
            str(self.host_docker_port),
        ]
        self.proxy_proc = subprocess.Popen(
            cmd,
            stdout=log,
            stderr=subprocess.STDOUT,
            close_fds=True,
        )
        self._write_pid(self.paths.proxy_pid, self.proxy_proc.pid)
        self.wait_for_path(self.paths.docker_sock, timeout=10.0)

    def wait_for_docker_ready(self, timeout: float) -> None:
        request = (
            b"GET /_ping HTTP/1.1\r\n"
            b"Host: docker\r\n"
            b"Connection: close\r\n\r\n"
        )
        deadline = time.time() + timeout
        last_error: str | None = None
        while time.time() < deadline:
            try:
                status, body = self.unix_http_request(
                    self.paths.docker_sock, request)
                if status == 200 and body.strip() == b"OK":
                    return
            except (OSError, DockerVmError) as exc:
                last_error = str(exc)
            self._ensure_processes_alive()
            time.sleep(0.2)
        detail = "Timed out waiting for Docker over the project-local Unix socket"
        if last_error:
            detail += f" (last probe error: {last_error})"
        raise DockerVmError(detail)

    def start(self) -> None:
        self.ensure_host_prerequisites()
        self.ensure_runtime_root()
        self.acquire_lock()
        self.remove_stale_run_dir()
        self.create_run_dir()
        self.write_state("starting")
        self.ensure_data_disk()
        self.network = self._compute_network()
        self.host_docker_port = self._allocate_host_docker_port()
        try:
            self.start_virtiofsd()
            self.start_qemu()
            self.start_proxy()
            self.wait_for_docker_ready(timeout=DOCKER_VM_BOOT_TIMEOUT)
            self.write_state(
                "running",
                qemu_pid=(self.qemu_proc.pid if self.qemu_proc else None),
                virtiofsd_pid=(self.virtiofsd_proc.pid
                               if self.virtiofsd_proc else None),
                proxy_pid=(self.proxy_proc.pid if self.proxy_proc else None),
                host_docker_port=self.host_docker_port,
                guest_network=(vars(self.network) if self.network else None),
                outbound_network=("enabled" if self.network_enabled
                                  else "restricted"),
                published_ports=([vars(p) for p in self.published_ports]
                                 if self.published_ports else []),
            )
        except Exception:
            self.write_state("failed")
            self.shutdown(clean=False, update_status=False)
            raise

    def shutdown(self, clean: bool, update_status: bool = True) -> None:
        if update_status and os.path.exists(self.paths.state):
            try:
                self.write_state("stopping")
            except OSError:
                pass

        timeout = (
            DOCKER_VM_FAST_SHUTDOWN_TIMEOUT
            if clean
            else DOCKER_VM_SHUTDOWN_TIMEOUT
        )

        # On normal sandbox exit, prefer fast teardown over a long graceful wait.
        if clean:
            for proc in (self.qemu_proc, self.virtiofsd_proc, self.proxy_proc):
                if proc is not None and proc.poll() is None:
                    proc.terminate()

        deadline = time.time() + timeout
        for proc in (self.qemu_proc, self.virtiofsd_proc, self.proxy_proc):
            if proc is None:
                continue
            while proc.poll() is None and time.time() < deadline:
                time.sleep(0.1)
            if proc.poll() is None:
                proc.terminate()

        for proc in (self.qemu_proc, self.virtiofsd_proc, self.proxy_proc):
            if proc is None:
                continue
            try:
                proc.wait(timeout=2.0)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=2.0)

        if clean and os.path.isdir(self.paths.run):
            shutil.rmtree(self.paths.run, ignore_errors=True)
        self.release_lock()


def proxy_bidirectional(left: socket.socket, right: socket.socket,
                        left_name: str = "left", right_name: str = "right"
                        ) -> None:
    """Copy bytes between two connected sockets with TCP-style half-close."""
    sel = selectors.DefaultSelector()
    sel.register(left, selectors.EVENT_READ, right)
    sel.register(right, selectors.EVENT_READ, left)
    closed_read: set[socket.socket] = set()
    names = {left: left_name, right: right_name}
    try:
        while len(closed_read) < 2:
            events = sel.select()
            if not events:
                continue
            for key, _ in events:
                src = key.fileobj
                if src in closed_read:
                    continue
                dst = key.data
                try:
                    chunk = src.recv(65536)
                except ConnectionResetError:
                    print(
                        "docker-vm-proxy: peer reset connection on "
                        f"{names[src]}",
                        flush=True,
                    )
                    chunk = b""
                if not chunk:
                    print(
                        f"docker-vm-proxy: EOF on {names[src]}, "
                        f"shutting down write side of {names[dst]}",
                        flush=True,
                    )
                    closed_read.add(src)
                    try:
                        sel.unregister(src)
                    except Exception:
                        pass
                    try:
                        dst.shutdown(socket.SHUT_WR)
                    except OSError:
                        pass
                    continue
                print(
                    f"docker-vm-proxy: relaying {len(chunk)} bytes "
                    f"{names[src]} -> {names[dst]}",
                    flush=True,
                )
                dst.sendall(chunk)
    finally:
        for sock_obj in (left, right):
            try:
                sel.unregister(sock_obj)
            except Exception:
                pass
            try:
                sock_obj.close()
            except OSError:
                pass


def handle_docker_vm_proxy_client(client: socket.socket, target_host: str,
                                  target_port: int) -> None:
    """Bridge one host Unix socket client into the forwarded guest Docker TCP port."""
    try:
        print(
            "docker-vm-proxy: accepted client, connecting to "
            f"{target_host}:{target_port}",
            flush=True,
        )
        upstream = socket.create_connection((target_host, target_port), timeout=2.0)
        print("docker-vm-proxy: upstream tcp connection established", flush=True)
    except OSError as exc:
        print(f"docker-vm-proxy: failed to connect upstream: {exc}", flush=True)
        client.close()
        return
    proxy_bidirectional(client, upstream, "client", "upstream")


def docker_vm_proxy_main(argv: list[str]) -> int:
    """Run the host Unix-socket proxy for the project-local Docker VM."""
    parser = argparse.ArgumentParser(
        prog="sandbox-wrap __docker-vm-proxy",
        add_help=True,
    )
    parser.add_argument("--listen", required=True)
    parser.add_argument("--target-host", required=True)
    parser.add_argument("--target-port", type=int, required=True)
    args = parser.parse_args(argv)

    def _stop(_signum, _frame) -> None:
        raise SystemExit(0)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, _stop)

    if os.path.exists(args.listen):
        os.unlink(args.listen)

    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as listener:
        listener.bind(args.listen)
        os.chmod(args.listen, 0o600)
        listener.listen()
        try:
            while True:
                client, _ = listener.accept()
                thread = threading.Thread(
                    target=handle_docker_vm_proxy_client,
                    args=(client, args.target_host, args.target_port),
                    daemon=True,
                )
                thread.start()
        finally:
            try:
                os.unlink(args.listen)
            except FileNotFoundError:
                pass


def detect_tool(argv0: str) -> str | None:
    """Detect tool from invocation name."""
    base = os.path.basename(argv0)
    if "codex" in base:
        return "codex"
    if "copilot" in base:
        return "copilot"
    return None


def ensure_sandbox_dir(project: str) -> str:
    """Create .sandbox/ if needed, return its absolute path."""
    sandbox = os.path.join(project, ".sandbox")
    os.makedirs(sandbox, exist_ok=True)
    return sandbox


def ensure_gitignore(project: str) -> None:
    """Append .sandbox/ to .gitignore if not already present."""
    gitignore = os.path.join(project, ".gitignore")
    entry = ".sandbox/"
    if os.path.exists(gitignore):
        with open(gitignore) as f:
            contents = f.read()
        if entry in contents.splitlines():
            return
    with open(gitignore, "a") as f:
        f.write(f"\n{entry}\n")


def ensure_project_mise_config(project: str) -> None:
    """Create mise.toml with defaults if no mise config exists."""
    if (os.path.exists(os.path.join(project, "mise.toml")) or
            os.path.exists(os.path.join(project, ".mise.toml"))):
        return
    path = os.path.join(project, "mise.toml")
    with open(path, "w") as f:
        f.write(DEFAULT_MISE_TOML)
    print(f"Created {path} with default toolchain entries")


def ensure_sandbox_mise_config(sandbox: str, tool: str,
                               aws: bool = False,
                               gh: bool = False) -> None:
    """Write sandbox-specific mise config with the AI tool entry."""
    config_dir = os.path.join(sandbox, ".config", "mise")
    os.makedirs(config_dir, exist_ok=True)
    config_path = os.path.join(config_dir, "config.toml")

    lines = ["[tools]"]

    tool_def = TOOLS[tool]
    if tool_def["mise_package"]:
        lines.append(
            f'"{tool_def["mise_package"]}" = "{tool_def["mise_version"]}"')

    if aws:
        lines.append('"aws-cli" = "2"')

    if gh:
        lines.append('"github-cli" = "latest"')

    content = "\n".join(lines) + "\n"
    # Only write if content changed
    if os.path.exists(config_path):
        with open(config_path) as f:
            if f.read() == content:
                return
    with open(config_path, "w") as f:
        f.write(content)


def get_tmp_dir(project: str) -> str:
    """Return a project-specific /tmp directory on the host."""
    h = hashlib.sha256(project.encode()).hexdigest()[:16]
    tmp = os.path.join("/tmp", f"sandbox-{h}")
    os.makedirs(tmp, exist_ok=True)
    return tmp


def find_mise_binary() -> str | None:
    """Find the mise binary path."""
    return shutil.which("mise")


def acquire_aws_credentials(profile: str) -> dict[str, str]:
    """Acquire AWS credentials for the given profile.

    Uses 'aws configure export-credentials' which works universally
    across credential sources: IAM Identity Center (SSO), IAM users,
    assumed roles, etc.
    """
    # Export credentials as JSON
    try:
        result = subprocess.run(
            ["aws", "configure", "export-credentials",
             "--profile", profile, "--format", "process"],
            capture_output=True, text=True, timeout=30,
        )
    except FileNotFoundError:
        die("aws CLI is not installed")
    except subprocess.TimeoutExpired:
        die(f"Timed out acquiring AWS credentials for profile '{profile}'")

    if result.returncode != 0:
        die(f"Failed to export AWS credentials for profile '{profile}':\n"
            f"{result.stderr.strip()}\n"
            f"You may need to run: aws sso login --profile {profile}")

    try:
        creds = json.loads(result.stdout)
    except json.JSONDecodeError:
        die(f"Failed to parse AWS credentials output for profile '{profile}'")

    env: dict[str, str] = {}
    if "AccessKeyId" in creds:
        env["AWS_ACCESS_KEY_ID"] = creds["AccessKeyId"]
    if "SecretAccessKey" in creds:
        env["AWS_SECRET_ACCESS_KEY"] = creds["SecretAccessKey"]
    if "SessionToken" in creds:
        env["AWS_SESSION_TOKEN"] = creds["SessionToken"]

    if not env.get("AWS_ACCESS_KEY_ID"):
        die(f"No credentials found for AWS profile '{profile}'")

    # Determine the region from the profile
    try:
        result = subprocess.run(
            ["aws", "configure", "get", "region", "--profile", profile],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode == 0 and result.stdout.strip():
            env["AWS_DEFAULT_REGION"] = result.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass

    return env


def acquire_gh_token() -> str | None:
    """Extract GitHub CLI auth token from the host keyring via 'gh auth token'."""
    try:
        result = subprocess.run(
            ["gh", "auth", "token"],
            capture_output=True, text=True, timeout=10,
        )
        if result.returncode == 0 and result.stdout.strip():
            return result.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError):
        pass
    return None


def is_core_system_dir(path: str) -> bool:
    """Return True for paths already covered by standard system mounts."""
    core_dirs = ("/usr", "/bin", "/sbin", "/lib", "/lib64")
    return path in core_dirs or path.startswith(tuple(d + "/" for d in core_dirs))


def ensure_ns_dir(args: list[str], path: str, created: set[str]) -> None:
    """Ensure an absolute directory path exists inside the sandbox namespace."""
    if not path or not path.startswith("/"):
        return
    parts = path.split("/")
    chain = ""
    for part in parts[1:]:
        if not part:
            continue
        chain += "/" + part
        if chain in created:
            continue
        args += ["--dir", chain]
        created.add(chain)


def paths_overlap(path_a: str, path_b: str) -> bool:
    """Return True when either path is equal to or nested under the other."""
    a = os.path.realpath(path_a)
    b = os.path.realpath(path_b)
    return a == b or a.startswith(b + "/") or b.startswith(a + "/")


def discover_home_bin_symlink_target_dirs(host_bin_dir: str) -> list[str]:
    """Return sorted unique real directories targeted by symlinks in ~/bin."""
    target_dirs: set[str] = set()
    try:
        entries = os.listdir(host_bin_dir)
    except OSError:
        return []

    for name in entries:
        link_path = os.path.join(host_bin_dir, name)
        if not os.path.islink(link_path):
            continue
        target_abs = os.path.realpath(link_path)
        if not os.path.exists(target_abs):
            continue
        if os.path.isdir(target_abs):
            target_dir = os.path.realpath(target_abs)
        else:
            target_dir = os.path.realpath(os.path.dirname(target_abs))
        if os.path.isdir(target_dir):
            target_dirs.add(target_dir)

    return sorted(target_dirs)


# ---------------------------------------------------------------------------
# bwrap command construction
# ---------------------------------------------------------------------------

def build_bwrap_args(
    project: str,
    sandbox: str,
    tool: str,
    *,
    no_net: bool = False,
    docker: bool = False,
    docker_socket_path: str | None = None,
    gh_token: str | None = None,
    aws_env: dict[str, str] | None = None,
    extra_ro: list[str] | None = None,
    extra_rw: list[str] | None = None,
    pass_env: list[str] | None = None,
    cli_args: list[str] | None = None,
) -> list[str]:
    """Build the full bwrap command line."""
    uid = os.getuid()
    gid = os.getgid()
    user = os.environ.get("USER", "sandbox")
    sandbox_home = f"/home/{user}"
    tmp_dir = get_tmp_dir(project)
    mise_bin = find_mise_binary()

    args: list[str] = ["bwrap"]

    # -- Namespace and security --
    args += ["--unshare-all", "--cap-drop", "ALL"]
    if not no_net:
        args += ["--share-net"]
    args += ["--die-with-parent", "--new-session"]
    args += ["--uid", str(uid), "--gid", str(gid)]

    # -- Clear environment --
    args += ["--clearenv"]

    # -- System directories (read-only) --
    for d in SYSTEM_RO_DIRS:
        if os.path.exists(d):
            args += ["--ro-bind", d, d]

    # /lib64 may be a symlink or a real dir
    if os.path.exists("/lib64"):
        real = os.path.realpath("/lib64")
        if os.path.islink("/lib64"):
            # It's a symlink; the target is already mounted via /usr or similar.
            args += ["--symlink", os.readlink("/lib64"), "/lib64"]
        else:
            args += ["--ro-bind", "/lib64", "/lib64"]

    # /etc entries
    args += ["--tmpfs", "/etc"]
    for entry in ETC_RO_ENTRIES:
        path = f"/etc/{entry}"
        if os.path.exists(path):
            args += ["--ro-bind", path, path]

    # /etc/java* (glob)
    for path in sorted(glob.glob("/etc/java*")):
        if os.path.exists(path):
            args += ["--ro-bind", path, path]

    # /proc, /dev, /tmp, /var
    args += ["--proc", "/proc"]
    args += ["--dev", "/dev"]
    args += ["--bind", tmp_dir, "/tmp"]
    args += ["--tmpfs", "/var"]

    # -- HOME --
    # HOME must be mounted before the project if the project path is under
    # sandbox_home, so we can then "poke through" with the project bind.
    args += ["--bind", sandbox, sandbox_home]

    # -- Project directory (read-write) --
    # If the project is under sandbox_home, we need intermediate directories
    # inside .sandbox/ so bwrap has mount points for the project bind.
    if project.startswith(sandbox_home + "/"):
        rel = os.path.relpath(project, sandbox_home)
        os.makedirs(os.path.join(sandbox, rel), exist_ok=True)
    args += ["--bind", project, project]

    # .git read-only overlay
    git_dir = os.path.join(project, ".git")
    if os.path.isdir(git_dir):
        args += ["--ro-bind", git_dir, git_dir]

    # Hide .sandbox inside the sandbox
    sandbox_in_project = os.path.join(project, ".sandbox")
    args += ["--tmpfs", sandbox_in_project]

    # -- mise binary --
    # mise is in /usr/bin which is already mounted, but if it's elsewhere
    # we need to mount it explicitly.
    if mise_bin:
        mise_real = os.path.realpath(mise_bin)
        mise_parent = os.path.dirname(mise_real)
        # Check if it's already covered by system mounts
        covered = any(mise_real.startswith(d + "/") for d in SYSTEM_RO_DIRS)
        if not covered and not mise_real.startswith("/lib64"):
            args += ["--ro-bind", mise_real, mise_real]

    # -- App home directories (auth, config, cache from host) --
    host_home = os.path.expanduser("~")
    tool_def = TOOLS[tool]
    for rel_dir in tool_def.get("host_home_mounts", []):
        host_dir = os.path.join(host_home, rel_dir)
        if os.path.exists(host_dir):
            # Ensure mount point exists inside .sandbox/
            os.makedirs(os.path.join(sandbox, rel_dir), exist_ok=True)
            sandbox_dir = f"{sandbox_home}/{rel_dir}"
            args += ["--bind", host_dir, sandbox_dir]

    # -- Host ~/bin and symlink targets (read-only) --
    # Expose host ~/bin for custom scripts and mount symlink target dirs
    # read-only so those symlinks remain usable inside the sandbox.
    host_bin_dir = os.path.join(host_home, "bin")
    if os.path.isdir(host_bin_dir):
        os.makedirs(os.path.join(sandbox, "bin"), exist_ok=True)
        args += ["--ro-bind", host_bin_dir, f"{sandbox_home}/bin"]

        ns_dirs_created = {
            "/", "/run", "/etc", "/usr", "/usr/local", "/usr/local/bin",
            "/bin", "/sbin", "/lib", "/lib64", "/home", sandbox_home,
            "/tmp", "/var", "/proc", "/dev",
        }
        mounted_targets: set[tuple[str, str]] = set()

        for target_dir_abs in discover_home_bin_symlink_target_dirs(host_bin_dir):
            # Core system paths are already mounted.
            if is_core_system_dir(target_dir_abs):
                continue

            # Never remount over the project path; that would downgrade the
            # project's rw bind to read-only.
            if paths_overlap(target_dir_abs, project):
                continue

            # ~/bin itself is already mounted above.
            if (target_dir_abs == host_bin_dir or
                    target_dir_abs.startswith(host_bin_dir + "/")):
                continue

            if target_dir_abs == host_home:
                target_dir_sb = sandbox_home
            elif target_dir_abs.startswith(host_home + "/"):
                target_rel = os.path.relpath(target_dir_abs, host_home)
                os.makedirs(os.path.join(sandbox, target_rel), exist_ok=True)
                target_dir_sb = f"{sandbox_home}/{target_rel}"
            else:
                target_dir_sb = target_dir_abs
                ensure_ns_dir(args, target_dir_sb, ns_dirs_created)

            if target_dir_sb == f"{sandbox_home}/bin":
                continue

            target_key = (target_dir_abs, target_dir_sb)
            if target_key in mounted_targets:
                continue
            args += ["--ro-bind", target_dir_abs, target_dir_sb]
            mounted_targets.add(target_key)

    # -- Docker (opt-in) --
    if docker:
        if not docker_socket_path:
            raise DockerVmError(
                "VM-backed Docker requires a project-local Docker socket path")
        sock = os.path.abspath(docker_socket_path)
        if not os.path.exists(sock):
            raise DockerVmError(
                f"Project-local Docker socket does not exist: {sock}")
        args += ["--bind", sock, "/run/docker.sock"]
        # Also mount at /var/run/docker.sock since many tools look there
        args += ["--dir", "/var/run"]
        args += ["--bind", sock, "/var/run/docker.sock"]
        docker_config = os.path.expanduser("~/.docker")
        if os.path.isdir(docker_config):
            os.makedirs(os.path.join(sandbox, ".docker"), exist_ok=True)
            args += ["--bind", docker_config, f"{sandbox_home}/.docker"]

    # -- GitHub CLI (opt-in) --
    # Mount ~/.config/gh read-only for config; auth is via GH_TOKEN env var
    # since the host keyring (D-Bus Secret Service) isn't accessible in the
    # sandbox.
    if gh_token is not None:
        gh_config = os.path.expanduser("~/.config/gh")
        if os.path.isdir(gh_config):
            os.makedirs(os.path.join(sandbox, ".config", "gh"), exist_ok=True)
            args += ["--ro-bind", gh_config,
                      f"{sandbox_home}/.config/gh"]

    # -- Extra mounts --
    for path in (extra_ro or []):
        abs_path = os.path.abspath(path)
        if os.path.exists(abs_path):
            args += ["--ro-bind", abs_path, abs_path]
        else:
            print(f"warning: --ro path does not exist: {path}",
                  file=sys.stderr)

    for path in (extra_rw or []):
        abs_path = os.path.abspath(path)
        if os.path.exists(abs_path):
            args += ["--bind", abs_path, abs_path]
        else:
            print(f"warning: --rw path does not exist: {path}",
                  file=sys.stderr)

    # -- Environment variables --
    env_vars: dict[str, str] = {}

    # Core
    env_vars["HOME"] = sandbox_home
    env_vars["USER"] = user
    env_vars["LOGNAME"] = user
    env_vars["TERM"] = os.environ.get("TERM", "xterm-256color")
    env_vars["LANG"] = os.environ.get("LANG", "en_US.UTF-8")

    # XDG
    env_vars["XDG_CACHE_HOME"] = f"{sandbox_home}/.cache"
    env_vars["XDG_CONFIG_HOME"] = f"{sandbox_home}/.config"
    env_vars["XDG_DATA_HOME"] = f"{sandbox_home}/.local/share"
    env_vars["XDG_STATE_HOME"] = f"{sandbox_home}/.local/state"

    # PATH: mise shims, home bin, system paths
    path_parts = [
        f"{sandbox_home}/.local/share/mise/shims",
        f"{sandbox_home}/.local/bin",
        f"{sandbox_home}/bin",
        "/usr/local/sbin", "/usr/local/bin",
        "/usr/sbin", "/usr/bin",
        "/sbin", "/bin",
    ]
    env_vars["PATH"] = ":".join(path_parts)

    # TMPDIR
    env_vars["TMPDIR"] = "/tmp"

    # Credential nullification
    env_vars.update(CREDENTIAL_NULLS)

    # AWS credentials (from STS) or nullification
    if aws_env:
        env_vars.update(aws_env)

    # GitHub CLI token (extracted from host keyring)
    if gh_token:
        env_vars["GH_TOKEN"] = gh_token

    if docker:
        env_vars["DOCKER_HOST"] = "unix:///run/docker.sock"

    # Pass-through env vars
    for var in (pass_env or []):
        val = os.environ.get(var)
        if val is not None:
            env_vars[var] = val

    # Set all env vars via --setenv
    for key, val in env_vars.items():
        args += ["--setenv", key, val]

    # -- Working directory --
    args += ["--chdir", project]

    # -- Command to run inside sandbox --
    # If extra args are given, they replace the tool command entirely.
    # Otherwise, run the default tool CLI with auto-flags.
    tool_def = TOOLS[tool]
    extra = list(cli_args or [])

    if extra:
        # Extra args = the command to run (replaces tool)
        cmd_parts = [shell_quote(a) for a in extra]
        tool_cmd = " ".join(cmd_parts)
    else:
        # Default: run the tool with auto-flags
        parts = [tool_def["cli"]] + list(tool_def["auto_flags"])
        tool_cmd = " ".join(shell_quote(a) for a in parts)

    # Build the inner command
    # Use mise activate to set up PATH properly, then exec the command
    inner_parts = [
        # Trust the project directory for mise
        'export MISE_TRUSTED_CONFIG_PATHS="$PWD"',
        # Install toolchains (idempotent, non-fatal so partial failures
        # don't prevent the agent from launching)
        'mise install --yes 2>&1 || true',
        # Activate mise in the current shell to get proper PATH
        'eval "$(mise activate bash --shims)"',
    ]

    inner_parts.append(f'exec {tool_cmd}')

    inner_script = " && ".join(inner_parts)
    args += ["bash", "-c", inner_script]

    return args


def shell_quote(s: str) -> str:
    """Quote a string for shell use."""
    if s and all(c.isalnum() or c in "-_=/.:" for c in s):
        return s
    return "'" + s.replace("'", "'\\''") + "'"


# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=os.path.basename(argv[0]),
        description="Run an AI coding agent in a sandboxed environment.",
        add_help=True,
    )
    parser.add_argument(
        "--project", default=os.getcwd(),
        help="Project directory (default: $PWD)",
    )
    parser.add_argument(
        "--tool", choices=["codex", "copilot"],
        help="Explicit tool selection (overrides invocation name)",
    )
    parser.add_argument(
        "--no-net", action="store_true",
        help="Disable network access inside the sandbox",
    )
    parser.add_argument(
        "--docker", action="store_true",
        help="Start a project-local Docker VM and mount its socket "
             "into the sandbox",
    )
    parser.add_argument(
        "--docker-publish", action="append", default=[], metavar="HOST:GUEST",
        help="Expose guest TCP port GUEST on host localhost:HOST "
             "(repeatable, Docker VM only)",
    )
    parser.add_argument(
        "--gh", action="store_true",
        help="Mount gh config (read-only) and pass auth token into sandbox",
    )
    parser.add_argument(
        "--aws", metavar="PROFILE",
        help="Acquire temporary AWS credentials via STS for the given profile",
    )
    parser.add_argument(
        "--ro", action="append", default=[], metavar="PATH",
        help="Extra read-only bind mount (repeatable)",
    )
    parser.add_argument(
        "--rw", action="append", default=[], metavar="PATH",
        help="Extra read-write bind mount (repeatable)",
    )
    parser.add_argument(
        "--pass-env", action="append", default=[], metavar="VAR",
        help="Pass host environment variable into sandbox (repeatable)",
    )
    parser.add_argument(
        "--reset", action="store_true",
        help="Remove .sandbox/ and start fresh",
    )
    # Everything after -- goes to the tool
    parser.add_argument(
        "extra", nargs=argparse.REMAINDER,
        help=argparse.SUPPRESS,
    )

    args = parser.parse_args(argv[1:])

    # Strip leading '--' from extra args
    if args.extra and args.extra[0] == "--":
        args.extra = args.extra[1:]

    return args


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] == "__docker-vm-proxy":
        raise SystemExit(docker_vm_proxy_main(sys.argv[2:]))

    args = parse_args(sys.argv)
    repo_root = os.path.dirname(os.path.realpath(__file__))

    # Determine tool
    tool = args.tool or detect_tool(sys.argv[0])
    if not tool:
        die("Cannot determine tool from invocation name. "
            "Use --tool codex|copilot or invoke as codex-wrap/copilot-wrap.")

    if tool not in TOOLS:
        die(f"Unknown tool: {tool}")

    # Resolve project directory
    project = os.path.abspath(args.project)
    if not os.path.isdir(project):
        die(f"Project directory does not exist: {project}")

    # Check bwrap
    if not shutil.which("bwrap"):
        die("bubblewrap (bwrap) is not installed. "
            "Install it with: sudo apt install bubblewrap")

    # Check mise
    if not find_mise_binary():
        die("mise is not installed. "
            "Install it from: https://mise.jdx.dev")

    # Handle --reset
    sandbox_path = os.path.join(project, ".sandbox")
    if args.reset:
        docker_vm_root = os.path.join(sandbox_path, DOCKER_VM_DIRNAME)
        if os.path.isdir(docker_vm_root):
            manager = DockerVmManager(project, sandbox_path, repo_root)
            if not manager.reset_is_allowed():
                die("--reset refused because a Docker sandbox is active "
                    f"for this project ({docker_vm_root})")
        if os.path.exists(sandbox_path):
            shutil.rmtree(sandbox_path)
            print("Removed .sandbox/")
        else:
            print(".sandbox/ does not exist, nothing to reset")
        return

    # Set up .sandbox
    sandbox = ensure_sandbox_dir(project)
    ensure_gitignore(project)

    # Set up mise configs
    ensure_project_mise_config(project)
    ensure_sandbox_mise_config(sandbox, tool, aws=bool(args.aws),
                               gh=args.gh)

    # Acquire AWS credentials if requested
    aws_env = None
    if args.aws:
        print(f"Acquiring AWS credentials for profile '{args.aws}'...")
        aws_env = acquire_aws_credentials(args.aws)
        print("AWS credentials acquired")

    # Acquire GitHub CLI token if requested
    gh_token = None
    if args.gh:
        gh_token = acquire_gh_token()
        if gh_token:
            print("GitHub CLI token acquired")
        else:
            print("warning: --gh specified but could not extract token "
                  "(run 'gh auth login' on the host)", file=sys.stderr)

    docker_vm: DockerVmManager | None = None
    if args.docker:
        if args.docker_publish and args.no_net:
            die("--docker-publish requires Docker VM networking; "
                "do not combine it with --no-net")
        published_ports = [
            DockerVmForward(*parse_forward_spec(spec))
            for spec in args.docker_publish
        ]
        docker_vm = DockerVmManager(
            project,
            sandbox,
            repo_root,
            network_enabled=not args.no_net,
            published_ports=published_ports,
        )
        try:
            docker_vm.start()
        except DockerVmError as exc:
            die(str(exc))

    # Build bwrap command
    try:
        bwrap_args = build_bwrap_args(
            project=project,
            sandbox=sandbox,
            tool=tool,
            no_net=args.no_net,
            docker=args.docker,
            docker_socket_path=(docker_vm.paths.docker_sock
                                if docker_vm else None),
            gh_token=gh_token,
            aws_env=aws_env,
            extra_ro=args.ro,
            extra_rw=args.rw,
            pass_env=args.pass_env,
            cli_args=args.extra,
        )
    except DockerVmError as exc:
        if docker_vm is not None:
            docker_vm.shutdown(clean=True)
        die(str(exc))

    if not args.docker:
        os.execvp("bwrap", bwrap_args)

    sandbox_proc: subprocess.Popen | None = None
    old_handlers: dict[int, object] = {}

    def _forward_signal(signum, _frame) -> None:
        if sandbox_proc is not None and sandbox_proc.poll() is None:
            sandbox_proc.send_signal(signum)

    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        old_handlers[sig] = signal.signal(sig, _forward_signal)

    exit_code = 1
    try:
        sandbox_proc = subprocess.Popen(bwrap_args)
        exit_code = sandbox_proc.wait()
    finally:
        for sig, handler in old_handlers.items():
            signal.signal(sig, handler)
        if docker_vm is not None:
            docker_vm.shutdown(clean=True)

    if exit_code < 0:
        raise SystemExit(128 + (-exit_code))
    raise SystemExit(exit_code)


if __name__ == "__main__":
    main()
