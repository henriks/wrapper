def die(msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def resolve_host_binary(name: str) -> str | None:
    """Resolve a host binary from PATH or common distro-specific locations."""
    override_var = HOST_TOOL_ENV_OVERRIDES.get(name)
    if override_var:
        override_path = os.environ.get(override_var)
        if override_path:
            if os.path.isfile(override_path) and os.access(override_path, os.X_OK):
                return override_path
            raise DockerVmError(
                f"{override_var} is set to a non-executable path: {override_path}"
            )
    path = shutil.which(name)
    if path:
        return path
    for candidate in HOST_TOOL_FALLBACKS.get(name, []):
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None


def is_rw_accessible(path: str) -> bool:
    """Return True when a path exists and is readable/writable."""
    return os.path.exists(path) and os.access(path, os.R_OK | os.W_OK)


def read_tail(path: str, max_bytes: int = 4096) -> str:
    """Return the last bytes of a log file as text, best-effort."""
    if not os.path.exists(path):
        return ""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read()
    except OSError:
        return ""
    return data.decode("utf-8", "replace").strip()


def parse_forward_spec(spec: str) -> tuple[int, int]:
    """Parse HOST_PORT:GUEST_PORT forward specs."""
    parts = spec.split(":", 1)
    if len(parts) != 2:
        raise DockerVmError(
            f"Invalid --docker-publish value '{spec}', expected HOST:GUEST"
        )
    try:
        host_port = int(parts[0], 10)
        guest_port = int(parts[1], 10)
    except ValueError as exc:
        raise DockerVmError(
            f"Invalid --docker-publish value '{spec}', expected HOST:GUEST"
        ) from exc
    for port in (host_port, guest_port):
        if port < 1 or port > 65535:
            raise DockerVmError(
                f"Invalid --docker-publish value '{spec}', ports must be 1-65535"
            )
    return host_port, guest_port


def parse_http_response(response: bytes) -> tuple[int, dict[str, str], bytes]:
    """Parse a minimal HTTP response and return status, headers, and body."""
    header_blob, _, body_blob = response.partition(b"\r\n\r\n")
    if not header_blob:
        raise DockerVmError("Empty HTTP response")
    lines = header_blob.splitlines()
    status_line = lines[0].decode("utf-8", "replace")
    try:
        status_code = int(status_line.split()[1])
    except (IndexError, ValueError) as exc:
        raise DockerVmError(f"Unexpected HTTP response: {status_line}") from exc

    headers: dict[str, str] = {}
    for line in lines[1:]:
        try:
            key, value = line.decode("utf-8", "replace").split(":", 1)
        except ValueError:
            continue
        headers[key.strip().lower()] = value.strip()
    return status_code, headers, body_blob


def read_http_response_from_socket(sock: socket.socket, context: str
                                   ) -> tuple[int, dict[str, str], bytes]:
    """Read one HTTP response without waiting for the peer to close."""
    sock.settimeout(2.0)
    response = bytearray()
    header_end = -1
    while header_end == -1:
        chunk = sock.recv(65536)
        if not chunk:
            break
        response.extend(chunk)
        header_end = response.find(b"\r\n\r\n")

    if header_end == -1:
        raise DockerVmError(f"Incomplete HTTP response from {context}")

    status, headers, body = parse_http_response(bytes(response))
    content_length = headers.get("content-length")
    expected_length = 0
    if content_length is not None:
        try:
            expected_length = int(content_length)
        except ValueError as exc:
            raise DockerVmError(
                f"Invalid Content-Length from {context}: {content_length}"
            ) from exc
        while len(body) < expected_length:
            chunk = sock.recv(65536)
            if not chunk:
                break
            body += chunk
        if len(body) < expected_length:
            raise DockerVmError(
                f"Incomplete HTTP body from {context}: "
                f"expected {expected_length} bytes, got {len(body)}"
            )
        body = body[:expected_length]
    return status, headers, body


def ensure_kernel_cmdline_rootfstype_ext4(cmdline: str) -> str:
    """Add rootfstype=ext4 when the appliance manifest omits it."""
    if "rootfstype=" in cmdline:
        return cmdline
    return cmdline.replace("root=/dev/vda", "root=/dev/vda rootfstype=ext4", 1)


def ensure_kernel_cmdline_console_ttys0(cmdline: str) -> str:
    """Add console=ttyS0 for host-side guest console capture."""
    if "console=ttyS0" in cmdline:
        return cmdline
    return f"console=ttyS0 {cmdline}"


def append_kernel_cmdline_arg(cmdline: str, key: str, value: str) -> str:
    """Append a kernel cmdline key=value argument."""
    if any(ch.isspace() for ch in value):
        raise DockerVmError(
            f"Docker VM does not support whitespace in {key}: {value}"
        )
    return f"{cmdline} {key}={value}"


class DockerVmError(RuntimeError):
    """Raised when Docker VM lifecycle management fails."""


@dataclass(frozen=True)
class DockerVmForward:
    """One localhost TCP forward into the guest."""

    host_port: int
    guest_port: int


@dataclass(frozen=True)
class DockerVmNetwork:
    """Guest network parameters for QEMU user-mode networking."""

    guest_ip: str
    prefix_len: int
    gateway_ip: str
    guest_mac: str
    dns_ip: str


@dataclass
class DockerVmPaths:
    """Project-local paths for the Docker VM runtime."""

