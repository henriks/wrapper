# Alpine release inputs for the guest rootfs.
ALPINE_VERSION=3.22.0
ALPINE_BRANCH=v3.22
ALPINE_ARCH=x86_64
ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine

# Root filesystem image size. This is the logical size of the packed ext4
# image, not the expected space consumed on disk.
ROOTFS_SIZE=512M

# Runtime defaults baked into the appliance manifest.
DOCKER_TCP_PORT=1075
VIRTIOFS_TAG=workspace

# Explicit Alpine package version pins. Refresh these with
# docker/refresh-pins.sh before building.
DOCKER_ENGINE_VERSION=28.3.3-r5
LINUX_VIRT_VERSION=6.12.79-r0
MKINITFS_VERSION=3.12.0-r0
PYTHON3_VERSION=3.12.12-r0
E2FSPROGS_VERSION=1.47.2-r2
IPROUTE2_VERSION=6.15.0-r0
UTIL_LINUX_VERSION=2.41-r9
