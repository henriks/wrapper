#!/usr/bin/env bash
set -euo pipefail

sandbox_wrap_have() { command -v "$1" >/dev/null 2>&1; }

sandbox_wrap_abspath() {
  if sandbox_wrap_have realpath; then realpath "$1"
  elif sandbox_wrap_have readlink; then readlink -f "$1"
  elif sandbox_wrap_have python3; then python3 - <<'PY' "$1"
import os,sys; print(os.path.realpath(sys.argv[1]))
PY
  else echo "Need realpath/readlink/python3" >&2; exit 2
  fi
}

sandbox_wrap_usage() {
  local app="$1"
  local usage_name default_cmd home_flag home_var no_home_flag

  case "$app" in
    codex)
      usage_name="codex-bwrap"
      default_cmd="codex"
      home_flag="--codex-home"
      home_var="CODEX_HOME"
      no_home_flag="--no-codex"
      ;;
    copilot)
      usage_name="copilot-wrap"
      default_cmd="copilot"
      home_flag="--copilot-home"
      home_var="COPILOT_HOME"
      no_home_flag="--no-copilot"
      ;;
    *)
      echo "Unsupported app: $app" >&2
      return 2
      ;;
  esac

  cat >&2 <<TXT
Usage:
  ${usage_name} [options] -- [command...]
  ${usage_name} [options]                 # default: ${default_cmd} (internal sandbox/approvals bypassed)

Options:
  --project PATH          Project directory to mount (default: \$PWD)
  --project-ro            Mount project read-only (default: rw)
  ${home_flag} PATH       Host ${default_cmd^} home dir to mount read-write
                          (default: \${${home_var}:-~/.${default_cmd}})
  ${no_home_flag}         Do not mount host ${default_cmd^} home (default: mount read-write)
  --mise-data PATH        Host mise data dir to mount read-write
                          (default: \${MISE_DATA_DIR:-\$XDG_DATA_HOME/mise} or ~/.local/share/mise)
  --mise-state PATH       Host mise state dir to mount read-write
                          (default: \${MISE_STATE_DIR:-\$XDG_STATE_HOME/mise} or ~/.local/state/mise)
  --mise-config-ro        Also mount host ~/.config/mise read-only (default: off)
  --no-mise               Do not mount mise dirs (default: mount mise if present)
  --docker-config PATH    Host Docker config dir to mount read-write
                          (default: \${DOCKER_CONFIG:-~/.docker})
  --docker-sock PATH      Host Docker socket path to mount (default: auto-detect)
  --no-docker             Do not mount Docker config/socket (default: mount if possible)
  --ro PATH               Extra read-only bind (repeatable)
  --rw PATH               Extra read-write bind (repeatable)
  --pass-env VAR          Pass through a single env var (repeatable)
  --no-net                Disable networking (default: enabled)
  --persist PATH          Persist sandbox HOME under PATH (default: ephemeral)
TXT
  return 2
}

sandbox_wrap_main() {
  local app="${1:-}"
  shift || true

  if [[ "$app" != "codex" && "$app" != "copilot" ]]; then
    echo "Unsupported app: $app" >&2
    return 2
  fi

  local PROJECT="$PWD"
  local PROJECT_MODE="rw"
  local NO_NET=0
  local PERSIST=""
  local NO_APP=0
  local NO_MISE=0
  local MISE_CONFIG_RO=0
  local NO_DOCKER=0
  local APP_HOME_HOST="${APP_HOME_HOST:-}"
  local MISE_DATA_HOST="${MISE_DATA_HOST:-}"
  local MISE_STATE_HOST="${MISE_STATE_HOST:-}"
  local DOCKER_CONFIG_HOST="${DOCKER_CONFIG_HOST:-}"
  local DOCKER_SOCK_HOST="${DOCKER_SOCK_HOST:-}"
  declare -a EXTRA_RO=()
  declare -a EXTRA_RW=()
  declare -a PASS_ENV=()

  local HOST_HOME="${HOME:-/home/$(id -un)}"
  local HOST_XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}"
  local HOST_DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}"
  local HOST_DISPLAY="${DISPLAY:-}"
  local HOST_WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}"
  local HOST_XAUTHORITY="${XAUTHORITY:-}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project)      PROJECT="${2:-}"; shift 2;;
      --project-ro)   PROJECT_MODE="ro"; shift;;
      --codex-home)
        if [[ "$app" != "codex" ]]; then break; fi
        APP_HOME_HOST="${2:-}"; shift 2;;
      --no-codex)
        if [[ "$app" != "codex" ]]; then break; fi
        NO_APP=1; shift;;
      --copilot-home)
        if [[ "$app" != "copilot" ]]; then break; fi
        APP_HOME_HOST="${2:-}"; shift 2;;
      --no-copilot)
        if [[ "$app" != "copilot" ]]; then break; fi
        NO_APP=1; shift;;
      --mise-data)    MISE_DATA_HOST="${2:-}"; shift 2;;
      --mise-state)   MISE_STATE_HOST="${2:-}"; shift 2;;
      --mise-config-ro) MISE_CONFIG_RO=1; shift;;
      --no-mise)      NO_MISE=1; shift;;
      --docker-config) DOCKER_CONFIG_HOST="${2:-}"; shift 2;;
      --docker-sock)  DOCKER_SOCK_HOST="${2:-}"; shift 2;;
      --no-docker)    NO_DOCKER=1; shift;;
      --ro)           EXTRA_RO+=("${2:-}"); shift 2;;
      --rw)           EXTRA_RW+=("${2:-}"); shift 2;;
      --pass-env)     PASS_ENV+=("${2:-}"); shift 2;;
      --no-net)       NO_NET=1; shift;;
      --persist)      PERSIST="${2:-}"; shift 2;;
      --)             shift; break;;
      -h|--help)      sandbox_wrap_usage "$app";;
      *)              break;;
    esac
  done

  local default_cmd
  if [[ "$app" == "codex" ]]; then
    default_cmd="codex"
  else
    default_cmd="copilot"
  fi

  local -a CMD=( "$@" )
  if [[ ${#CMD[@]} -eq 0 ]]; then CMD=( "$default_cmd" ); fi

  local COPILOT_BIN_DIR_HOST=""
  if [[ "$app" == "copilot" ]]; then
    if [[ "${CMD[0]}" == "copilot" ]]; then
      local copilot_bin_resolved
      copilot_bin_resolved="$(command -v copilot 2>/dev/null || true)"
      if [[ -n "$copilot_bin_resolved" ]]; then
        CMD[0]="$copilot_bin_resolved"
      fi
    fi

    if [[ "$(basename -- "${CMD[0]}")" == "copilot" ]]; then
      COPILOT_BIN_DIR_HOST="$(dirname -- "${CMD[0]}")"
      local have_allow_all=0
      local have_no_auto_update=0
      local a
      for a in "${CMD[@]:1}"; do
        if [[ "$a" == "--allow-all" ]]; then
          have_allow_all=1
        fi
        if [[ "$a" == "--no-auto-update" ]]; then
          have_no_auto_update=1
        fi
      done
      if [[ $have_allow_all -eq 0 ]]; then
        CMD=( "${CMD[0]}" --allow-all "${CMD[@]:1}" )
      fi
      if [[ $have_no_auto_update -eq 0 ]]; then
        CMD=( "${CMD[0]}" --no-auto-update "${CMD[@]:1}" )
      fi
    fi
  fi

  if [[ "$app" == "codex" && "$(basename -- "${CMD[0]}")" == "codex" ]]; then
    local have_bypass_flag=0
    local a
    for a in "${CMD[@]:1}"; do
      if [[ "$a" == "--dangerously-bypass-approvals-and-sandbox" ]]; then
        have_bypass_flag=1
        break
      fi
    done
    if [[ $have_bypass_flag -eq 0 ]]; then
      CMD=( "${CMD[0]}" --dangerously-bypass-approvals-and-sandbox "${CMD[@]:1}" )
    fi
  fi

  if ! sandbox_wrap_have bwrap; then
    echo "bwrap not found. Install bubblewrap." >&2
    return 1
  fi

  local PROJECT_ABS
  PROJECT_ABS="$(sandbox_wrap_abspath "$PROJECT")"
  [[ -d "$PROJECT_ABS" ]] || { echo "Not a directory: $PROJECT_ABS" >&2; return 1; }

  local TMPROOT=""
  local HOME_SRC
  cleanup_sandbox_wrap_tmproot() {
    [[ -n "$TMPROOT" && -d "$TMPROOT" ]] && rm -rf "$TMPROOT"
  }

  if [[ -n "$PERSIST" ]]; then
    local PERSIST_ABS
    PERSIST_ABS="$(sandbox_wrap_abspath "$PERSIST")"
    mkdir -p "$PERSIST_ABS/home"
    HOME_SRC="$PERSIST_ABS/home"
  else
    TMPROOT="$(mktemp -d -t "${app}-bwrap.XXXXXXXX")"
    trap cleanup_sandbox_wrap_tmproot EXIT
    mkdir -p "$TMPROOT/home"
    HOME_SRC="$TMPROOT/home"
  fi

  local HOST_USER="${USER:-$(id -un)}"
  local HOST_UID
  HOST_UID="$(id -u)"
  local HOST_GID
  HOST_GID="$(id -g)"
  local SB_HOME="/home/$HOST_USER"
  local SB_RUNTIME="/run/user/$HOST_UID"
  local SB_APP_HOME="$SB_HOME/.${app}"

  mkdir -p \
    "$HOME_SRC/.cache" \
    "$HOME_SRC/.config" \
    "$HOME_SRC/.${app}" \
    "$HOME_SRC/bin" \
    "$HOME_SRC/.docker" \
    "$HOME_SRC/.local/share" \
    "$HOME_SRC/.local/state" \
    "$HOME_SRC/.local/bin"

  case "$app" in
    codex) : "${APP_HOME_HOST:=${CODEX_HOME:-$HOST_HOME/.codex}}" ;;
    copilot) : "${APP_HOME_HOST:=${COPILOT_HOME:-$HOST_HOME/.copilot}}" ;;
  esac

  local XDG_DATA_HOME_HOST="${XDG_DATA_HOME:-$HOST_HOME/.local/share}"
  local XDG_CONFIG_HOME_HOST="${XDG_CONFIG_HOME:-$HOST_HOME/.config}"
  local XDG_STATE_HOME_HOST="${XDG_STATE_HOME:-$HOST_HOME/.local/state}"
  local XDG_CACHE_HOME_HOST="${XDG_CACHE_HOME:-$HOST_HOME/.cache}"

  : "${MISE_DATA_HOST:=${MISE_DATA_DIR:-$XDG_DATA_HOME_HOST/mise}}"
  : "${MISE_STATE_HOST:=${MISE_STATE_DIR:-$XDG_STATE_HOME_HOST/mise}}"
  local MISE_DATA_HOST_DEFAULT="$HOST_HOME/.local/share/mise"
  local MISE_STATE_HOST_DEFAULT="$HOST_HOME/.local/state/mise"
  [[ -d "$MISE_DATA_HOST" ]] || MISE_DATA_HOST="$MISE_DATA_HOST_DEFAULT"
  [[ -d "$MISE_STATE_HOST" ]] || MISE_STATE_HOST="$MISE_STATE_HOST_DEFAULT"
  local MISE_CONFIG_HOST="$XDG_CONFIG_HOME_HOST/mise"

  local COPILOT_CONFIG_HOST=""
  local COPILOT_CACHE_HOST=""
  local GH_CONFIG_HOST=""
  if [[ "$app" == "copilot" ]]; then
    COPILOT_CONFIG_HOST="$XDG_CONFIG_HOME_HOST/github-copilot"
    COPILOT_CACHE_HOST="$XDG_CACHE_HOME_HOST/github-copilot"
    GH_CONFIG_HOST="$XDG_CONFIG_HOME_HOST/gh"
  fi

  : "${DOCKER_CONFIG_HOST:=${DOCKER_CONFIG:-$HOST_HOME/.docker}}"
  if [[ -z "${DOCKER_SOCK_HOST:-}" ]]; then
    if [[ -n "${DOCKER_HOST:-}" && "${DOCKER_HOST}" == unix://* ]]; then
      local CANDIDATE_SOCK
      CANDIDATE_SOCK="${DOCKER_HOST#unix://}"
      [[ -S "$CANDIDATE_SOCK" ]] && DOCKER_SOCK_HOST="$CANDIDATE_SOCK"
    fi
    if [[ -z "${DOCKER_SOCK_HOST:-}" ]]; then
      local CANDIDATE_SOCK
      for CANDIDATE_SOCK in /var/run/docker.sock /run/docker.sock "/run/user/$HOST_UID/docker.sock"; do
        if [[ -S "$CANDIDATE_SOCK" ]]; then
          DOCKER_SOCK_HOST="$CANDIDATE_SOCK"
          break
        fi
      done
    fi
  fi

  local CARGO_HOME_HOST="${CARGO_HOME:-$HOST_HOME/.cargo}"
  local RUSTUP_HOME_HOST="${RUSTUP_HOME:-$HOST_HOME/.rustup}"
  local MAVEN_CONFIG_HOST="${MAVEN_CONFIG:-$HOST_HOME/.m2}"
  local MISE_BIN_HOST
  MISE_BIN_HOST="$(command -v mise 2>/dev/null || true)"

  declare -a BW=(
    bwrap
    --die-with-parent
    --new-session
    --unshare-all
    --cap-drop ALL
    --uid "$HOST_UID"
    --gid "$HOST_GID"
    --clearenv
  )

  if [[ "$NO_NET" -eq 0 ]]; then BW+=( --share-net ); fi

  BW+=(
    --tmpfs /
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    --tmpfs /var
    --dir /run
    --dir /etc
    --dir /usr
    --dir /usr/local
    --dir /usr/local/bin
    --dir /bin
    --dir /sbin
    --dir /lib
    --dir /lib64
    --dir /home
  )

  local d
  for d in /usr /usr/local /bin /sbin /lib /lib64; do
    [[ -e "$d" ]] && BW+=( --ro-bind "$d" "$d" )
  done

  local f
  for f in /etc/resolv.conf /etc/hosts /etc/nsswitch.conf /etc/passwd /etc/group /etc/localtime; do
    [[ -e "$f" ]] && BW+=( --ro-bind "$f" "$f" )
  done
  [[ -d /etc/ssl ]] && BW+=( --ro-bind /etc/ssl /etc/ssl )
  [[ -d /etc/alternatives ]] && BW+=( --ro-bind /etc/alternatives /etc/alternatives )
  [[ -d /etc/pki ]] && BW+=( --ro-bind /etc/pki /etc/pki )
  [[ -d /etc/ca-certificates ]] && BW+=( --ro-bind /etc/ca-certificates /etc/ca-certificates )
  [[ -e /etc/mavenrc ]] && BW+=( --ro-bind /etc/mavenrc /etc/mavenrc )

  for d in /etc/java*; do
    [[ -d "$d" ]] && BW+=( --ro-bind "$d" "$d" )
  done

  BW+=(
    --dir "$SB_HOME"
    --bind "$HOME_SRC" "$SB_HOME"
    --setenv HOME "$SB_HOME"
    --setenv USER "$HOST_USER"
    --setenv LOGNAME "$HOST_USER"
    --setenv XDG_CACHE_HOME "$SB_HOME/.cache"
    --setenv XDG_CONFIG_HOME "$SB_HOME/.config"
    --setenv XDG_DATA_HOME "$SB_HOME/.local/share"
    --setenv XDG_STATE_HOME "$SB_HOME/.local/state"
    --setenv MISE_DATA_DIR "$SB_HOME/.local/share/mise"
    --setenv MISE_STATE_DIR "$SB_HOME/.local/state/mise"
    --setenv MISE_CONFIG_DIR "$SB_HOME/.config/mise"
    --setenv CARGO_HOME "$SB_HOME/.cargo"
    --setenv RUSTUP_HOME "$SB_HOME/.rustup"
    --setenv MAVEN_CONFIG "$SB_HOME/.m2"
    --setenv DOCKER_CONFIG "$SB_HOME/.docker"
    --setenv TMPDIR /tmp
  )

  if [[ "$app" == "codex" ]]; then
    BW+=( --setenv CODEX_HOME "$SB_APP_HOME" )
  else
    BW+=( --setenv COPILOT_HOME "$SB_APP_HOME" --setenv COPILOT_WRAP_SANDBOX 1 )
  fi

  if [[ "$app" == "copilot" ]]; then
    if [[ -n "$HOST_XDG_RUNTIME_DIR" && -d "$HOST_XDG_RUNTIME_DIR" ]]; then
      local HOST_XDG_RUNTIME_DIR_ABS
      HOST_XDG_RUNTIME_DIR_ABS="$(sandbox_wrap_abspath "$HOST_XDG_RUNTIME_DIR")"
      BW+=(
        --dir /run/user
        --dir "$SB_RUNTIME"
        --bind "$HOST_XDG_RUNTIME_DIR_ABS" "$SB_RUNTIME"
        --setenv XDG_RUNTIME_DIR "$SB_RUNTIME"
      )

      if [[ -n "$HOST_DBUS_SESSION_BUS_ADDRESS" ]]; then
        local DBUS_ADDR_SB
        DBUS_ADDR_SB="${HOST_DBUS_SESSION_BUS_ADDRESS//$HOST_XDG_RUNTIME_DIR/$SB_RUNTIME}"
        BW+=( --setenv DBUS_SESSION_BUS_ADDRESS "$DBUS_ADDR_SB" )
      fi
    fi

    [[ -n "$HOST_DISPLAY" ]] && BW+=( --setenv DISPLAY "$HOST_DISPLAY" )
    [[ -n "$HOST_WAYLAND_DISPLAY" ]] && BW+=( --setenv WAYLAND_DISPLAY "$HOST_WAYLAND_DISPLAY" )
    [[ -n "$HOST_XAUTHORITY" ]] && BW+=( --setenv XAUTHORITY "$HOST_XAUTHORITY" )
  fi

  BW+=(
    --setenv SSH_AUTH_SOCK ""
    --setenv GIT_CONFIG_GLOBAL /dev/null
    --setenv AWS_SHARED_CREDENTIALS_FILE /dev/null
    --setenv AWS_CONFIG_FILE /dev/null
    --setenv GOOGLE_APPLICATION_CREDENTIALS ""
    --setenv KUBECONFIG /dev/null
  )

  if [[ "$app" == "copilot" ]]; then
    local v
    for v in COPILOT_GITHUB_TOKEN GH_TOKEN GITHUB_TOKEN; do
      if [[ -n "${!v-}" ]]; then
        BW+=( --setenv "$v" "${!v}" )
      fi
    done
  fi

  if [[ "$NO_APP" -eq 0 ]]; then
    mkdir -p "$APP_HOME_HOST"
    local APP_HOME_HOST_ABS
    APP_HOME_HOST_ABS="$(sandbox_wrap_abspath "$APP_HOME_HOST")"
    BW+=( --bind "$APP_HOME_HOST_ABS" "$SB_APP_HOME" )

    if [[ "$app" == "copilot" ]]; then
      mkdir -p "$COPILOT_CONFIG_HOST"
      local COPILOT_CONFIG_HOST_ABS
      COPILOT_CONFIG_HOST_ABS="$(sandbox_wrap_abspath "$COPILOT_CONFIG_HOST")"
      BW+=( --bind "$COPILOT_CONFIG_HOST_ABS" "$SB_HOME/.config/github-copilot" )

      mkdir -p "$COPILOT_CACHE_HOST"
      local COPILOT_CACHE_HOST_ABS
      COPILOT_CACHE_HOST_ABS="$(sandbox_wrap_abspath "$COPILOT_CACHE_HOST")"
      BW+=( --bind "$COPILOT_CACHE_HOST_ABS" "$SB_HOME/.cache/github-copilot" )

      if [[ -d "$GH_CONFIG_HOST" ]]; then
        local GH_CONFIG_HOST_ABS
        GH_CONFIG_HOST_ABS="$(sandbox_wrap_abspath "$GH_CONFIG_HOST")"
        BW+=( --bind "$GH_CONFIG_HOST_ABS" "$SB_HOME/.config/gh" )
      fi
    fi
  fi

  if [[ "$NO_DOCKER" -eq 0 ]]; then
    mkdir -p "$DOCKER_CONFIG_HOST"
    local DOCKER_CONFIG_ABS
    DOCKER_CONFIG_ABS="$(sandbox_wrap_abspath "$DOCKER_CONFIG_HOST")"
    BW+=( --bind "$DOCKER_CONFIG_ABS" "$SB_HOME/.docker" )

    if [[ -n "${DOCKER_SOCK_HOST:-}" ]]; then
      local DOCKER_SOCK_ABS
      DOCKER_SOCK_ABS="$(sandbox_wrap_abspath "$DOCKER_SOCK_HOST")"
      if [[ -S "$DOCKER_SOCK_ABS" ]]; then
        BW+=( --ro-bind "$DOCKER_SOCK_ABS" /run/docker.sock )
        BW+=( --dir /var/run --ro-bind "$DOCKER_SOCK_ABS" /var/run/docker.sock )
        BW+=( --setenv DOCKER_HOST "unix:///run/docker.sock" )
      fi
    fi
  fi

  if [[ "$NO_MISE" -eq 0 ]]; then
    mkdir -p "$MISE_DATA_HOST"
    local MISE_DATA_ABS
    MISE_DATA_ABS="$(sandbox_wrap_abspath "$MISE_DATA_HOST")"
    mkdir -p "$HOME_SRC/.local/share/mise"
    BW+=( --bind "$MISE_DATA_ABS" "$SB_HOME/.local/share/mise" )

    mkdir -p "$MISE_STATE_HOST"
    local MISE_STATE_ABS
    MISE_STATE_ABS="$(sandbox_wrap_abspath "$MISE_STATE_HOST")"
    mkdir -p "$HOME_SRC/.local/state/mise"
    BW+=( --bind "$MISE_STATE_ABS" "$SB_HOME/.local/state/mise" )

    if [[ "$MISE_CONFIG_RO" -eq 1 && -d "$MISE_CONFIG_HOST" ]]; then
      local MISE_CFG_ABS
      MISE_CFG_ABS="$(sandbox_wrap_abspath "$MISE_CONFIG_HOST")"
      mkdir -p "$HOME_SRC/.config/mise"
      BW+=( --ro-bind "$MISE_CFG_ABS" "$SB_HOME/.config/mise" )
    fi

    if [[ -n "$MISE_BIN_HOST" ]]; then
      case "$MISE_BIN_HOST" in
        "$HOST_HOME"/*)
          local MISE_BIN_ABS
          MISE_BIN_ABS="$(sandbox_wrap_abspath "$MISE_BIN_HOST")"
          BW+=( --ro-bind "$MISE_BIN_ABS" "$SB_HOME/.local/bin/mise" )
          ;;
      esac
    fi
  fi

  # Expose host ~/bin as read-only inside sandbox home for custom user scripts.
  local HOST_BIN_DIR="$HOST_HOME/bin"
  if [[ -d "$HOST_BIN_DIR" ]]; then
    local HOST_BIN_ABS
    HOST_BIN_ABS="$(sandbox_wrap_abspath "$HOST_BIN_DIR")"
    BW+=( --ro-bind "$HOST_BIN_ABS" "$SB_HOME/bin" )

    # Symlinked entries in ~/bin often point outside ~/bin.
    # Mount target directories read-only so those symlinks remain usable.
    declare -A SYMLINK_TARGET_MOUNTS=()
    declare -A DIRS_CREATED=(
      ["/"]=1
      ["/run"]=1
      ["/etc"]=1
      ["/usr"]=1
      ["/usr/local"]=1
      ["/usr/local/bin"]=1
      ["/bin"]=1
      ["/sbin"]=1
      ["/lib"]=1
      ["/lib64"]=1
      ["/home"]=1
      ["$SB_HOME"]=1
      ["/tmp"]=1
      ["/var"]=1
      ["/proc"]=1
      ["/dev"]=1
    )

    local link_path target_abs target_dir_abs target_dir_sb target_key
    while IFS= read -r -d '' link_path; do
      if ! target_abs="$(sandbox_wrap_abspath "$link_path" 2>/dev/null)"; then
        continue
      fi
      [[ -e "$target_abs" ]] || continue

      if [[ -d "$target_abs" ]]; then
        target_dir_abs="$(sandbox_wrap_abspath "$target_abs")"
      else
        target_dir_abs="$(sandbox_wrap_abspath "$(dirname -- "$target_abs")")"
      fi
      [[ -d "$target_dir_abs" ]] || continue

      # Core system dirs are already mounted.
      case "$target_dir_abs" in
        /usr|/usr/*|/usr/local|/usr/local/*|/bin|/bin/*|/sbin|/sbin/*|/lib|/lib/*|/lib64|/lib64/*)
          continue
          ;;
      esac

      if [[ "$target_dir_abs" == "$HOST_HOME" ]]; then
        target_dir_sb="$SB_HOME"
      elif [[ "$target_dir_abs" == "$HOST_HOME"/* ]]; then
        local target_rel
        target_rel="${target_dir_abs#"$HOST_HOME"/}"
        target_dir_sb="$SB_HOME/$target_rel"
        mkdir -p "$HOME_SRC/$target_rel"
      else
        target_dir_sb="$target_dir_abs"

        local chain part
        local -a parts=()
        chain=""
        IFS='/' read -r -a parts <<< "${target_dir_sb#/}"
        for part in "${parts[@]}"; do
          [[ -z "$part" ]] && continue
          chain="$chain/$part"
          if [[ -z "${DIRS_CREATED[$chain]+x}" ]]; then
            BW+=( --dir "$chain" )
            DIRS_CREATED["$chain"]=1
          fi
        done
      fi

      # ~/bin is already mounted above.
      if [[ "$target_dir_sb" == "$SB_HOME/bin" ]]; then
        continue
      fi

      target_key="$target_dir_abs:$target_dir_sb"
      if [[ -z "${SYMLINK_TARGET_MOUNTS[$target_key]+x}" ]]; then
        SYMLINK_TARGET_MOUNTS["$target_key"]=1
        BW+=( --ro-bind "$target_dir_abs" "$target_dir_sb" )
      fi
    done < <(find "$HOST_BIN_DIR" -mindepth 1 -maxdepth 1 -type l -print0 2>/dev/null || true)
  fi

  mkdir -p "$CARGO_HOME_HOST"
  local CARGO_HOME_ABS
  CARGO_HOME_ABS="$(sandbox_wrap_abspath "$CARGO_HOME_HOST")"
  mkdir -p "$HOME_SRC/.cargo"
  BW+=( --bind "$CARGO_HOME_ABS" "$SB_HOME/.cargo" )

  mkdir -p "$RUSTUP_HOME_HOST"
  local RUSTUP_HOME_ABS
  RUSTUP_HOME_ABS="$(sandbox_wrap_abspath "$RUSTUP_HOME_HOST")"
  mkdir -p "$HOME_SRC/.rustup"
  BW+=( --bind "$RUSTUP_HOME_ABS" "$SB_HOME/.rustup" )

  mkdir -p "$MAVEN_CONFIG_HOST"
  local MAVEN_CONFIG_ABS
  MAVEN_CONFIG_ABS="$(sandbox_wrap_abspath "$MAVEN_CONFIG_HOST")"
  mkdir -p "$HOME_SRC/.m2"
  BW+=( --bind "$MAVEN_CONFIG_ABS" "$SB_HOME/.m2" )

  if [[ "$app" == "codex" ]]; then
    BW+=(
      --setenv PATH "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$SB_HOME/bin:$SB_HOME/.cargo/bin:$SB_HOME/.local/share/mise/shims:$SB_HOME/.local/bin"
    )
  else
    local PATH_SB="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$SB_HOME/bin:$SB_HOME/.cargo/bin:$SB_HOME/.local/bin:$SB_HOME/.local/share/mise/shims"
    if [[ -n "$COPILOT_BIN_DIR_HOST" ]]; then
      PATH_SB="$COPILOT_BIN_DIR_HOST:$PATH_SB"
    fi
    BW+=( --setenv PATH "$PATH_SB" )
  fi

  local PROJECT_SB="/work"
  if [[ "$PROJECT_ABS" == "$HOST_HOME" ]]; then
    PROJECT_SB="$SB_HOME"
  elif [[ "$PROJECT_ABS" == "$HOST_HOME"/* ]]; then
    local PROJECT_REL
    PROJECT_REL="${PROJECT_ABS#"$HOST_HOME"/}"
    PROJECT_SB="$SB_HOME/$PROJECT_REL"
    mkdir -p "$HOME_SRC/$PROJECT_REL"
  fi

  if [[ "$PROJECT_SB" == "/work" ]]; then
    BW+=( --dir /work )
  fi

  if [[ "$PROJECT_MODE" == "ro" ]]; then
    BW+=( --ro-bind "$PROJECT_ABS" "$PROJECT_SB" )
  else
    BW+=( --bind "$PROJECT_ABS" "$PROJECT_SB" )
  fi
  BW+=( --chdir "$PROJECT_SB" )

  if [[ -d "$PROJECT_ABS/.git" ]]; then
    local PROJECT_GIT_ABS
    PROJECT_GIT_ABS="$(sandbox_wrap_abspath "$PROJECT_ABS/.git")"
    BW+=( --ro-bind "$PROJECT_GIT_ABS" "$PROJECT_SB/.git" )
  fi

  local p
  for p in "${EXTRA_RO[@]}"; do
    local P_ABS
    P_ABS="$(sandbox_wrap_abspath "$p")"
    BW+=( --ro-bind "$P_ABS" "$P_ABS" )
  done
  for p in "${EXTRA_RW[@]}"; do
    local P_ABS
    P_ABS="$(sandbox_wrap_abspath "$p")"
    BW+=( --bind "$P_ABS" "$P_ABS" )
  done

  local v
  for v in "${PASS_ENV[@]}"; do
    if [[ -n "${!v-}" ]]; then
      BW+=( --setenv "$v" "${!v}" )
    fi
  done

  exec "${BW[@]}" -- "${CMD[@]}"
}
